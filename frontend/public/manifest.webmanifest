  "icons": [
    {
      "src": "/icons/pwa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/pwa-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "url": "/dashboard?source=pwa-shortcut",
      "icons": [{ "src": "/icons/pwa-192.png", "sizes": "192x192" }]
    },
    {
      "name": "API Keys",
      "short_name": "API Keys",
      "url": "/keys?source=pwa-shortcut",
      "icons": [{ "src": "/icons/pwa-192.png", "sizes": "192x192" }]
    }
  ]
